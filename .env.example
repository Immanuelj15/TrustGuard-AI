# TrustGuard AI Configuration Example

PROJECT_NAME="TrustGuard AI"
ENVIRONMENT="development"
DEMO_MODE=true

# Security
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database
# Use SQLite for standalone local testing:
DATABASE_URL="sqlite:///./trustguard.db"
# Or PostgreSQL for production/docker:
# DATABASE_URL="postgresql://trustguard_user:trustguard_secure_db_pass_2026@localhost:5432/trustguard"

# Storage
STORAGE_TYPE="local" # 'local' or 'minio'
LOCAL_STORAGE_DIR="./storage"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="trustguard_minio"
MINIO_SECRET_KEY="trustguard_secret_2026"
MINIO_BUCKET_NAME="trustguard-evidence"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Pipeline Adapters
ENABLE_REAL_AUDIO_MODELS=false
ENABLE_REAL_VIDEO_MODELS=false
